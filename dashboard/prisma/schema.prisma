generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  phoneNumber   String   @unique
  name          String?
  lastHistory   String   @db.Text
  aiReasoning   String?  @db.Text
  interestedIn  String?
  status        String   @default("PENDING_CONTACT") // PENDING_CONTACT, CONTACTED, CONVERTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
